{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Group name or empty for DMs"
    },
    "type": {
      "type": "string",
      "enum": [
        "dm",
        "group"
      ],
      "default": "dm"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of participants. Hidden from nonmembers of public rooms to prevent membership enumeration.",
      "rls": {
        "read": {
          "$or": [
            {
              "data.participant_ids": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_message_text": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "avatar_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether a group can be discovered and joined by authenticated users."
    }
  },
  "required": [
    "participant_ids",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "data.is_public": true
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
