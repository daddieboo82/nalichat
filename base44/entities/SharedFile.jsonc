{
  "name": "SharedFile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "session",
        "document",
        "other"
      ],
      "default": "other"
    },
    "file_size": {
      "type": "number"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Price in USD (0 for free)",
      "default": 0
    },
    "uploader_id": {
      "type": "string"
    },
    "uploader_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Optional project association"
    },
    "folder_id": {
      "type": "string",
      "description": "Optional folder ID for organization"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Field-level security: readable by everyone, but only an admin may write it directly. Row-level RLS lets the uploader update their own SharedFile record, which would otherwise let them self-inflate this leaderboard metric with a direct entity update. Locked here for the same reason as ArtPost.likes \u2014 write only via a trusted server function using asServiceRole (service role bypasses FLS).",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "views": {
      "type": "number",
      "default": 0,
      "description": "Field-level security: readable by everyone, but only an admin may write it directly. Locked for the same self-inflation reason as 'likes' \u2014 write only via a trusted server function using asServiceRole.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "file_url",
    "uploader_id"
  ],
  "rls": {
    "create": {
      "data.uploader_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "data.uploader_id": "{{user.id}}"
    },
    "delete": {
      "data.uploader_id": "{{user.id}}"
    }
  }
}