{
  "name": "RelaxMedia",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the media item"
    },
    "description": {
      "type": "string",
      "description": "Short description or synopsis"
    },
    "category": {
      "type": "string",
      "description": "Category key this item belongs to (e.g. movies, tv, games, social, books, shopping, radio, music). Free-form so admins can add new categories anytime."
    },
    "media_type": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "iframe",
        "link"
      ],
      "default": "video",
      "description": "How the item plays: video (YouTube/Vimeo/mp4 embed), audio (radio/music stream), iframe (embeddable web app), or link (opens externally)"
    },
    "media_url": {
      "type": "string",
      "description": "Playable/embed URL for the media (video URL, audio stream, or external link)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Cover/poster image URL"
    },
    "backdrop_url": {
      "type": "string",
      "description": "Optional wide backdrop image for the immersive player background"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Highlight in the hero spotlight"
    },
    "rating": {
      "type": "number",
      "description": "Optional rating 0-10"
    },
    "year": {
      "type": "string",
      "description": "Optional release year / metadata line"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Manual ordering within a category"
    }
  },
  "required": [
    "title",
    "category",
    "media_type"
  ]
}