{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "host_artist_name": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "host_artist_id": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_track_url": {
      "type": "string",
      "description": "URL of the single uploaded source track (MP3/WAV) that producers remix from",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_track_name": {
      "type": "string",
      "description": "Name of the source track",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stem_file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy multi-stem uploads — kept for backward compatibility, no longer used by the UI",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stem_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy stem names — kept for backward compatibility, no longer used by the UI",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "genre": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "rules": {
      "type": "string"
    },
    "prize_description": {
      "type": "string"
    },
    "cover_url": {
      "type": "string",
      "description": "Server-managed trusted cover image URL",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "voting",
        "completed"
      ],
      "default": "upcoming",
      "description": "Server-managed challenge lifecycle state",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Server-managed challenge schedule",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "submission_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Server-managed challenge schedule",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "voting_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Server-managed challenge schedule",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "host_artist_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
