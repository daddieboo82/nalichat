{
  "name": "Re-engage Stalled Onboarding Users",
  "description": "Sends a reminder email to users who registered but never completed onboarding. Runs daily; each user gets at most one email (tracked via reengagement_sent_at).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reengage_stalled_onboarding_users",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reengageStalledUsers",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}