{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "description": "User ID who receives the notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "comment",
        "file",
        "session_invite",
        "milestone",
        "message"
      ],
      "description": "Type of notification"
    },
    "actor_id": {
      "type": "string",
      "description": "User ID who triggered the notification"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_avatar": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "Notification body text"
    },
    "link": {
      "type": "string",
      "description": "In-app path to navigate to"
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation target for message notifications"
    },
    "locked_chat": {
      "type": "boolean",
      "default": false,
      "description": "Whether all identifying preview fields were redacted for the recipient"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "recipient_id",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.actor_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "data.recipient_id": "{{user.id}}"
    },
    "update": {
      "data.recipient_id": "{{user.id}}"
    },
    "delete": {
      "data.recipient_id": "{{user.id}}"
    }
  }
}