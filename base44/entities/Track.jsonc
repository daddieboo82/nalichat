{
  "name": "Track",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "vocal",
        "instrument",
        "beat",
        "sample",
        "fx",
        "master"
      ],
      "default": "vocal"
    },
    "color": {
      "type": "string"
    },
    "volume": {
      "type": "number",
      "default": 75
    },
    "pan": {
      "type": "number",
      "default": 0
    },
    "muted": {
      "type": "boolean",
      "default": false
    },
    "solo": {
      "type": "boolean",
      "default": false
    },
    "duration": {
      "type": "number"
    },
    "uploaded_by": {
      "type": "string"
    },
    "waveform_data": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "suggested_genre": {
      "type": "string",
      "description": "AI-suggested genre based on the uploaded track"
    },
    "suggested_bpm": {
      "type": "number",
      "description": "AI-suggested BPM based on the uploaded track"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "project_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.uploaded_by": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.uploaded_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.uploaded_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}