{
  "name": "CallSummary",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "participant_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Service-owned visibility boundary copied from the call session"
    },
    "requested_by": {
      "type": "string"
    },
    "request_key": {
      "type": "string",
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": ["pending", "completed", "failed", "deleted"]
    },
    "transcript": {
      "type": "string",
      "maxLength": 200000
    },
    "summary": {
      "type": "string",
      "maxLength": 10000
    },
    "action_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error_code": {
      "type": "string",
      "maxLength": 80
    },
    "attempts": {
      "type": "number"
    },
    "processing_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_until": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session_id",
    "participant_ids",
    "requested_by",
    "request_key",
    "status",
    "attempts",
    "processing_started_at"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
