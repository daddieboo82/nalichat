{
  "name": "ArtPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song/Track title"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Album art or cover"
    },
    "file_url": {
      "type": "string",
      "description": "Audio file URL"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Price in USD (0 for free)",
      "default": 0
    },
    "medium": {
      "type": "string",
      "enum": [
        "original",
        "remix",
        "cover",
        "beat",
        "production",
        "mixing",
        "mastering",
        "collab"
      ],
      "default": "original"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "Field-level security: readable by everyone, but only an admin may write it directly. Without this, the row-level 'creator can update own post' rule would let a creator self-inflate their own like count with a direct entity update, bypassing toggleLike entirely. Real likes are written only by the toggleLike function via asServiceRole (service role bypasses FLS).",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Field-level security: readable by everyone, but only an admin may write it directly. Locked here for the same reason as 'likes' \u2014 written only by toggleLike via asServiceRole.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "creator_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_avatar": {
      "type": "string"
    },
    "views": {
      "type": "number",
      "default": 0,
      "description": "Field-level security: readable by everyone, but only an admin may write it directly. Locked for the same self-inflation reason as 'likes' \u2014 write only via a trusted server function using asServiceRole.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "duration": {
      "type": "number",
      "description": "Track duration in seconds"
    },
    "genre": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Field-level security: readable by everyone, but only an admin may write it directly. Without this, the row-level 'creator can update own post' rule would let any creator self-promote their own post to featured status. Curated/set only by an admin.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "creator_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.creator_id": "{{user.id}}"
    },
    "delete": {
      "data.creator_id": "{{user.id}}"
    }
  }
}