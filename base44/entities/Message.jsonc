{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the conversation"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "audio",
        "image",
        "session"
      ],
      "default": "text"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "description": "Audio duration in seconds"
    }
  },
  "required": [
    "conversation_id",
    "sender_id"
  ]
}