{
  "name": "LockedChatResetChallenge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "code_hash": {
      "type": "string",
      "description": "SHA-256 digest of the user-scoped one-time code"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "code_hash",
    "expires_at",
    "attempt_count"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
