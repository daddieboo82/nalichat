{
  "name": "ChallengeVote",
  "type": "object",
  "properties": {
    "submission_id": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    },
    "voter_id": {
      "type": "string"
    },
    "voter_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "submission_id",
    "challenge_id",
    "voter_id"
  ],
  "rls": {
    "create": {
      "data.voter_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.voter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}