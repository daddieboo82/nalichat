{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "genre": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artist_role": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "followers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "following": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "total_posts": {
      "type": "number",
      "default": 0
    },
    "total_likes_received": {
      "type": "number",
      "default": 0
    },
    "badge": {
      "type": "string",
      "description": "Special badge/title"
    }
  }
}