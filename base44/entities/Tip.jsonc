{
  "name": "Tip",
  "type": "object",
  "properties": {
    "tipper_id": {
      "type": "string",
      "description": "ID of the user who sent the tip. Null for anonymous tips."
    },
    "tipper_name": {
      "type": "string"
    },
    "creator_id": {
      "type": "string",
      "description": "ID of the creator receiving the tip"
    },
    "creator_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Tip amount in USD"
    },
    "message": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional message from the tipper"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "checkout_session_id": {
      "type": "string",
      "description": "Stripe checkout session ID"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "creator_id",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.tipper_id": "{{user.id}}"
        },
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}