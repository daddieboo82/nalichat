{
  "name": "ArtPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song/Track title"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Album art or cover"
    },
    "file_url": {
      "type": "string",
      "description": "Audio file URL"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Price in USD (0 for free)",
      "default": 0
    },
    "medium": {
      "type": "string",
      "enum": [
        "original",
        "remix",
        "cover",
        "beat",
        "production",
        "mixing",
        "mastering",
        "collab"
      ],
      "default": "original"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "creator_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_avatar": {
      "type": "string"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "duration": {
      "type": "number",
      "description": "Track duration in seconds"
    },
    "genre": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "is_explicit": {
      "type": "boolean",
      "description": "Whether the song contains explicit content",
      "default": false
    }
  },
  "required": [
    "creator_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.creator_id": "{{user.id}}"
    },
    "delete": {
      "data.creator_id": "{{user.id}}"
    }
  }
}