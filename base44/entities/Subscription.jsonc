{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the subscribed user"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "premium",
        "premium_plus",
        "pro",
        "pro_filesharing",
        "trial"
      ],
      "default": "free",
      "description": "Canonical tier (free, premium, premium_plus); legacy values remain valid during migration"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "canceled",
        "ended",
        "pending",
        "unpaid",
        "incomplete",
        "trial"
      ],
      "default": "active",
      "description": "Current lifecycle status; trial is a legacy alias for trialing"
    },
    "billing_period": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "description": "Recurring billing cadence"
    },
    "provider": {
      "type": "string",
      "enum": [
        "stripe",
        "wix",
        "manual",
        "unknown"
      ],
      "description": "Billing system of record; Wix is legacy"
    },
    "subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID (from Stripe webhook)"
    },
    "checkout_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID for correlation"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe Customer ID"
    },
    "stripe_product_id": {
      "type": "string",
      "description": "Stripe Product ID used by the external subscription"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe Price ID used by the external subscription"
    },
    "trial_target_plan": {
      "type": "string",
      "enum": [
        "premium",
        "premium_plus"
      ],
      "description": "Paid tier selected for a trial; legacy trials without this field default to premium"
    },
    "trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the account's trial began"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the trial ends (7 days from creation)"
    },
    "trial_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the account consumed its one-time trial eligibility"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false,
      "description": "Whether access should stop at the current period end"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "When current billing cycle ends"
    },
    "grandfathered": {
      "type": "boolean",
      "default": false,
      "description": "Whether legacy external billing terms are intentionally retained"
    },
    "grandfathered_from_plan": {
      "type": "string",
      "enum": [
        "pro",
        "pro_filesharing"
      ],
      "description": "Legacy plan that granted Premium Plus grandfathering"
    },
    "grandfathered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When grandfathering was recorded"
    },
    "migration_source_plan": {
      "type": "string",
      "enum": [
        "trial",
        "pro",
        "pro_filesharing"
      ],
      "description": "Legacy plan value before canonical normalization"
    },
    "migration_version": {
      "type": "string",
      "description": "Last subscription-domain migration applied"
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last subscription-domain migration was applied"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "plan",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}