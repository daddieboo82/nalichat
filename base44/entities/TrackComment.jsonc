{
  "name": "TrackComment",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string",
      "description": "ID of the ArtPost being commented on"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "timestamp": {
      "type": "number",
      "description": "Timestamp in seconds within the audio track (null = general comment)"
    },
    "parent_type": {
      "type": "string",
      "enum": [
        "art_post",
        "challenge_submission",
        "track"
      ],
      "description": "Explicit parent type for comment access control."
    }
  },
  "required": [
    "track_id",
    "author_id",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
