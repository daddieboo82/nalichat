{
  "name": "LockedConversationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of this per-user visibility preference"
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation hidden for this user only"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "conversation_id",
    "locked_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
