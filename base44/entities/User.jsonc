{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "artist",
        "producer",
        "engineer",
        "ar"
      ],
      "default": "user",
      "description": "Authorization role. 'admin' grants administrative privileges; all non-admin users should use 'user'. Legacy profession values remain accepted during migration.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "display_name": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "birthdate": {
      "type": "string",
      "format": "date",
      "description": "User's date of birth",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "bio": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "location": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "avatar_url": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "phone": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Server-managed flag set after required onboarding profile fields are validated.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "welcome_tour_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed or dismissed the guided welcome tour",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reengagement_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-managed timestamp of the last onboarding re-engagement email sent to this user (null = never sent). Locked so users cannot suppress the reminder workflow by marking themselves as already contacted.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "violation_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of content policy violations recorded for this user. Written only by server-side moderation via service role; locked here so a user cannot reset their own strike count.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "timeout_until": {
      "type": "string",
      "format": "date-time",
      "description": "If set and in the future, the user is timed out and cannot send messages until this time. Written only by moderateContent via asServiceRole; locked here so a timed-out user cannot clear their own timeout with auth.updateMe().",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "Permanently banned for repeated severe violations. Written only by moderateContent via asServiceRole; locked here so a banned user cannot self-unban with auth.updateMe().",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "squad_credits": {
      "type": "number",
      "default": 0,
      "description": "Squad & Scale co-op credits earned from hitting weekly squad goals",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "xp": {
      "type": "number",
      "default": 0,
      "description": "Experience points earned through platform activity",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "viral_concepts_generated": {
      "type": "number",
      "default": 0,
      "description": "Number of viral content concepts generated via ViralSeed AI",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "nali_presence_level": {
      "type": "string",
      "enum": [
        "proactive",
        "minimal",
        "off"
      ],
      "default": "proactive",
      "description": "How omnipresent Nali is across the app: proactive (auto hints), minimal (on-demand), or off (hidden)",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Server-managed Stripe Customer ID for this NaliChat account",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-managed timestamp reserving or consuming the account's one paid trial",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_claim_id": {
      "type": "string",
      "description": "Server-managed compare-and-set token used while creating the account's trial checkout",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_checkout_claim_id": {
      "type": "string",
      "description": "Server-managed lease preventing concurrent subscription checkout attempts",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_checkout_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current subscription checkout lease was acquired",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "artist_role": {
      "type": "string",
      "enum": [
        "artist",
        "producer",
        "engineer",
        "ar"
      ],
      "default": "artist",
      "description": "Public music-industry role shown on the profile. This is separate from the protected authorization role.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "website": {
      "type": "string",
      "description": "Optional public creator website URL",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "cover_url": {
      "type": "string",
      "description": "Public profile cover image URL",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_online": {
      "type": "boolean",
      "default": false,
      "description": "Server-managed realtime presence hint.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Server-managed timestamp of the latest presence heartbeat.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
