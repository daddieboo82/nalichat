{
  "name": "Squad",
  "type": "object",
  "properties": {
    "member_a_id": {
      "type": "string",
      "description": "User ID of the squad creator/inviter"
    },
    "member_a_name": {
      "type": "string"
    },
    "member_b_id": {
      "type": "string",
      "description": "User ID of the invited partner \u2014 empty until they accept"
    },
    "member_b_name": {
      "type": "string"
    },
    "invite_code": {
      "type": "string",
      "description": "Shareable code used to join this squad"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "ended"
      ],
      "default": "pending"
    }
  },
  "required": [
    "member_a_id",
    "invite_code"
  ],
  "rls": {
    "create": {
      "data.member_a_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.member_a_id": "{{user.id}}"
        },
        {
          "data.member_b_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.member_a_id": "{{user.id}}"
        },
        {
          "data.member_b_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.member_a_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}