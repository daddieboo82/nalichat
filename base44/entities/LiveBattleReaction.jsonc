{
  "name": "LiveBattleReaction",
  "type": "object",
  "properties": {
    "battle_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "reaction": {
      "type": "string",
      "enum": [
        "fire",
        "cheer",
        "love"
      ]
    },
    "bucket": {
      "type": "integer"
    }
  },
  "required": [
    "battle_id",
    "user_id",
    "reaction",
    "bucket"
  ],
  "rls": {
