{
  "name": "SquadReward",
  "type": "object",
  "properties": {
    "squad_id": { "type": "string" },
    "progress_id": { "type": "string" },
    "user_id": { "type": "string" },
    "credits": { "type": "number" },
    "week_key": { "type": "string" }
  },
  "required": ["squad_id", "progress_id", "user_id", "credits", "week_key"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
