{
  "name": "ChallengeSubmission",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "producer_id": {
      "type": "string"
    },
    "producer_name": {
      "type": "string"
    },
    "producer_avatar": {
      "type": "string"
    },
    "remix_file_url": {
      "type": "string"
    },
    "remix_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "vote_count": {
      "type": "number",
      "default": 0,
      "description": "Field-level security: readable by everyone, but only an admin may write it directly. Without this, the row-level 'producer can update own submission' rule would let a producer self-inflate their own vote_count with a direct entity update, bypassing castVote entirely. Real votes are written only by the castVote function via asServiceRole (service role bypasses FLS).",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_type": {
      "type": "string",
      "enum": [
        "nalichat_studio",
        "external_upload",
        "link_import"
      ]
    },
    "external_url": {
      "type": "string"
    },
    "file_format": {
      "type": "string",
      "enum": [
        "wav",
        "mp3"
      ]
    },
    "device_type": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "tablet"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "share_url": {
      "type": "string"
    }
  },
  "required": [
    "challenge_id",
    "producer_id",
    "remix_file_url",
    "remix_name"
  ],
  "rls": {
    "create": {
      "data.producer_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.producer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.producer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}