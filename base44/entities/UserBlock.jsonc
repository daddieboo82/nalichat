{
  "name": "UserBlock",
  "type": "object",
  "properties": {
    "blocker_id": {
      "type": "string"
    },
    "blocked_user_id": {
      "type": "string"
    }
  },
  "required": [
    "blocker_id",
    "blocked_user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.blocker_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}