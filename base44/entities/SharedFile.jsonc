{
  "name": "SharedFile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Shared file URL. Server-managed after trusted upload validation.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "file_type": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "session",
        "document",
        "other"
      ],
      "default": "other",
      "description": "Server-managed media classification established when the file is created.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "file_size": {
      "type": "number"
    },
    "uploader_id": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "uploader_name": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "project_id": {
      "type": "string",
      "description": "Optional project association",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "folder_id": {
      "type": "string",
      "description": "Optional folder ID for organization",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0,
      "description": "System-managed engagement counter.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "views": {
      "type": "number",
      "default": 0,
      "description": "System-managed engagement counter.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "access_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Users allowed to read this file inside NaliChat",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "share_token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the current opaque public share token",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "share_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry timestamp for the current public share token",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "edit_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Users allowed to modify or delete this file. Viewer-only collaborators are excluded.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "file_url",
    "uploader_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.uploader_id": "{{user.id}}"
        },
        {
          "data.access_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.edit_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.edit_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
