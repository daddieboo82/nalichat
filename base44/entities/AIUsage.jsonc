{
  "name": "AIUsage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Account charged for this end-user AI request"
    },
    "utc_day": {
      "type": "string",
      "description": "UTC date bucket in YYYY-MM-DD format"
    },
    "request_key": {
      "type": "string",
      "maxLength": 128,
      "description": "Opaque idempotency key; never prompt or message content"
    },
    "operation": {
      "type": "string",
      "maxLength": 80,
      "description": "Non-content operation category used for support aggregates"
    },
    "status": {
      "type": "string",
      "enum": ["reserved", "dispatched"],
      "description": "Reservations prevent obvious concurrent overrun; only dispatched rows count as used"
    },
    "reserved_at": {
      "type": "string",
      "format": "date-time"
    },
    "dispatched_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["user_id", "utc_day", "request_key", "operation", "status", "reserved_at"],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
