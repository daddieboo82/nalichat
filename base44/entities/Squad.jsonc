{
  "name": "Squad",
  "type": "object",
  "properties": {
    "member_a_id": {
      "type": "string",
      "description": "User ID of the squad creator/inviter"
    },
    "member_a_name": {
      "type": "string"
    },
    "member_b_id": {
      "type": "string",
      "description": "User ID of the invited partner — empty until they accept"
    },
    "member_b_name": {
      "type": "string"
    },
    "invite_code": {
      "type": "string",
      "description": "Shareable code used to join this squad"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "ended"
      ],
      "default": "pending"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "invite_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-managed expiry for a pending squad invite."
    }
  },
  "required": [
    "member_a_id",
    "invite_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.member_a_id": "{{user.id}}"
        },
        {
          "data.member_b_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
