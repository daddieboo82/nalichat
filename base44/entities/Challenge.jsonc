{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "host_artist_name": {
      "type": "string"
    },
    "host_artist_id": {
      "type": "string"
    },
    "stem_file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stem_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "genre": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "rules": {
      "type": "string"
    },
    "prize_description": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "voting",
        "completed"
      ],
      "default": "upcoming"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "submission_end_date": {
      "type": "string",
      "format": "date-time"
    },
    "voting_end_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "host_artist_id"
  ],
  "rls": {
    "create": {
      "data.host_artist_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.host_artist_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.host_artist_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}