{
  "name": "StudioPresence",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Identifier for the shared studio room/project being worked on"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user present in the room"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "activity": {
      "type": "string",
      "description": "Human-readable description of what the user is currently doing (e.g. 'Recording', 'Editing Vocals Lead')"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last presence heartbeat \u2014 used to detect who is still active"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "room_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}