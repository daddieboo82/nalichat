{
  "name": "TrackVersion",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string",
      "description": "ID of the parent Track"
    },
    "project_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "description": "Incrementing version number"
    },
    "label": {
      "type": "string",
      "description": "Optional user-given label, e.g. 'First mix', 'After vocal tuning'"
    },
    "file_url": {
      "type": "string"
    },
    "volume": {
      "type": "number"
    },
    "pan": {
      "type": "number"
    },
    "muted": {
      "type": "boolean"
    },
    "solo": {
      "type": "boolean"
    },
    "saved_by_id": {
      "type": "string"
    },
    "saved_by_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "access_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Project/session members allowed to read and collaborate on this audio record"
    }
  },
  "required": [
    "track_id",
    "project_id",
    "version_number",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.saved_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.saved_by_id": "{{user.id}}"
        },
        {
          "data.access_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.saved_by_id": "{{user.id}}"
        },
        {
          "data.access_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.saved_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
