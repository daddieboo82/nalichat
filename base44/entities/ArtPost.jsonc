{
  "name": "ArtPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Song/Track title"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Album art or cover. Server-managed after trusted upload validation.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "file_url": {
      "type": "string",
      "description": "Audio file URL. Server-managed after trusted upload validation.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "medium": {
      "type": "string",
      "enum": [
        "original",
        "remix",
        "cover",
        "beat",
        "production",
        "mixing",
        "mastering",
        "collab"
      ],
      "default": "original"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "likes": {
      "type": "number",
      "default": 0,
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "creator_id": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "creator_name": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "creator_avatar": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "views": {
      "type": "number",
      "default": 0,
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "duration": {
      "type": "number",
      "description": "Track duration in seconds"
    },
    "genre": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_explicit": {
      "type": "boolean",
      "description": "Whether the song contains explicit content",
      "default": false
    }
  },
  "required": [
    "creator_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
