{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "artist",
        "producer",
        "engineer",
        "ar"
      ],
      "default": "artist",
      "description": "Field-level security: anyone may read a role, but only an existing admin may write one. This is what actually stops privilege escalation - auth.updateMe() is a self-write, so without this rule any signed-in user could promote themselves to admin. Admin promotion is expected to go through the makeAdmin function, which verifies the caller is already an admin and then writes via asServiceRole (service role bypasses FLS).",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "display_name": {
      "type": "string"
    },
    "birthdate": {
      "type": "string",
      "format": "date",
      "description": "User's date of birth"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "phone": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "welcome_tour_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed or dismissed the guided welcome tour"
    },
    "reengagement_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last onboarding re-engagement email sent to this user (null = never sent)"
    },
    "violation_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of content policy violations recorded for this user. Written only by the moderateContent function via asServiceRole; locked here so a user cannot reset their own strike count.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "timeout_until": {
      "type": "string",
      "format": "date-time",
      "description": "If set and in the future, the user is timed out and cannot send messages until this time. Written only by moderateContent via asServiceRole; locked here so a timed-out user cannot clear their own timeout with auth.updateMe().",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "Permanently banned for repeated severe violations. Written only by moderateContent via asServiceRole; locked here so a banned user cannot self-unban with auth.updateMe().",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "squad_credits": {
      "type": "number",
      "default": 0,
      "description": "Squad & Scale co-op credits earned from hitting weekly squad goals"
    },
    "xp": {
      "type": "number",
      "default": 0,
      "description": "Experience points earned through platform activity"
    },
    "viral_concepts_generated": {
      "type": "number",
      "default": 0,
      "description": "Number of viral content concepts generated via ViralSeed AI"
    },
    "nali_presence_level": {
      "type": "string",
      "enum": [
        "proactive",
        "minimal",
        "off"
      ],
      "default": "proactive",
      "description": "How omnipresent Nali is across the app: proactive (auto hints), minimal (on-demand), or off (hidden)"
    },
    "chat_theme_id": {
      "type": "string",
      "enum": [
        "default",
        "midnight",
        "aurora",
        "sunset"
      ],
      "default": "default",
      "description": "Server-managed chat appearance preference. Premium IDs are written through setChatTheme after entitlement verification.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Server-managed Stripe Customer ID for this NaliChat account",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-managed timestamp reserving or consuming the account's one paid trial",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_claim_id": {
      "type": "string",
      "description": "Server-managed compare-and-set token used while creating the account's trial checkout",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "stripe_checkout_claim_id": {
        "type": "string",
        "description": "Server-managed lease preventing concurrent subscription checkout attempts",
        "rls": {
          "read": false,
          "write": {
            "user_condition": {
              "role": "admin"
            }
          }
        }
      },
      "stripe_checkout_claimed_at": {
        "type": "string",
        "format": "date-time",
        "description": "When the current subscription checkout lease was acquired",
        "rls": {
          "read": false,
          "write": {
            "user_condition": {
              "role": "admin"
            }
          }
        }
      }
    }
  }
}