{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Playlist name"
    },
    "description": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of ArtPost IDs in the playlist",
      "default": []
    },
    "cover_url": {
      "type": "string",
      "description": "Playlist cover image"
    },
    "is_public": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "owner_id"
  ]
}