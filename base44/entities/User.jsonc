{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "artist",
        "producer",
        "engineer",
        "ar"
      ],
      "default": "artist"
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "phone": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    }
  }
}