{
  "name": "SharedFile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "audio",
        "image",
        "video",
        "session",
        "document",
        "other"
      ],
      "default": "other"
    },
    "file_size": {
      "type": "number"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Price in USD (0 for free)",
      "default": 0
    },
    "uploader_id": {
      "type": "string"
    },
    "uploader_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Optional project association"
    },
    "folder_id": {
      "type": "string",
      "description": "Optional folder ID for organization"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "views": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "file_url",
    "uploader_id"
  ],
  "rls": {
    "create": {
      "data.uploader_id": "{{user.id}}"
    },
    "read": null,
    "update": null,
    "delete": null
  }
}