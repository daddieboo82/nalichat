{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "description": "User ID who receives the notification",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "comment",
        "file",
        "session_invite",
        "milestone",
        "message",
        "follow_up_reminder"
      ],
      "description": "Type of notification",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "actor_id": {
      "type": "string",
      "description": "User ID who triggered the notification",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "actor_name": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "actor_avatar": {
      "type": "string",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "message": {
      "type": "string",
      "description": "Notification body text",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "link": {
      "type": "string",
      "description": "In-app path to navigate to",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000,
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation associated with a message notification",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "locked_chat": {
      "type": "boolean",
      "default": false,
      "description": "True when a message notification was redacted because this recipient locked the conversation",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "follow_up_reminder_id": {
      "type": "string",
      "description": "Server-owned delivery correlation for follow-up reminder recovery",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "recipient_id",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.recipient_id": "{{user.id}}"
    },
    "update": {
      "data.recipient_id": "{{user.id}}"
    },
    "delete": {
      "data.recipient_id": "{{user.id}}"
    }
  }
}
