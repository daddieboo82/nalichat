{
  "name": "Contact",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who has the contact",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "contact_user_id": {
      "type": "string",
      "description": "ID of the user who is in the contact list"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_avatar": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "contact_user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
