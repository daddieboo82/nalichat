{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the conversation"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "audio",
        "image",
        "session"
      ],
      "default": "text"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "description": "Audio duration in seconds"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user IDs who have read this message",
      "default": []
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_text": {
      "type": "string"
    },
    "reply_to_sender": {
      "type": "string"
    },
    "reactions": {
      "type": "object"
    },
    "thread_id": {
      "type": "string",
      "description": "Parent message ID \u2014 set for thread replies"
    },
    "thread_reply_count": {
      "type": "number",
      "description": "Cached count of replies in this thread",
      "default": 0
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "sender_id"
  ],
  "rls": {
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "read": {
      "data.conversation_id": {
        "$in": {
          "$field": "id",
          "of": "Conversation",
          "with": {
            "data.participant_ids": "{{user.id}}"
          }
        }
      }
    },
    "update": {
      "data.sender_id": "{{user.id}}"
    },
    "delete": {
      "data.sender_id": "{{user.id}}"
    }
  }
}