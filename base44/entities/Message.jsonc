{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the conversation"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "audio",
        "image",
        "video",
        "session"
      ],
      "default": "text"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "description": "Audio duration in seconds"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user IDs who have read this message",
      "default": []
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_text": {
      "type": "string"
    },
    "reply_to_sender": {
      "type": "string"
    },
    "reactions": {
      "type": "object"
    },
    "thread_id": {
      "type": "string",
      "description": "Parent message ID — set for thread replies"
    },
    "thread_reply_count": {
      "type": "number",
      "description": "Cached count of replies in this thread",
      "default": 0
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of the conversation's participants at send time, copied from the Conversation — used to scope reads"
    },
    "client_message_key": {
      "type": "string",
      "description": "Stable client-generated idempotency key scoped to sender and conversation"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "sent"
      ],
      "default": "sent",
      "description": "Server-confirmed delivery state. Queued/sending/failed remain client-only."
    }
  },
  "required": [
    "conversation_id",
    "sender_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.participant_ids": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
