{
  "name": "Violation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who committed the violation"
    },
    "user_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "violence",
        "racism",
        "sexual_violence",
        "bullying",
        "illegal_activity"
      ],
      "description": "Category of policy violation detected"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "content": {
      "type": "string",
      "description": "The offending message content that triggered the violation"
    },
    "conversation_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "scheduled_message_id": {
      "type": "string",
      "description": "Server-only source schedule for a delivery-time moderation decision.",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "action_taken": {
      "type": "string",
      "enum": [
        "warning",
        "timeout",
        "ban"
      ],
      "description": "Enforcement action applied as a result of this violation"
    },
    "explanation": {
      "type": "string",
      "description": "AI explanation of why the content was flagged"
    }
  },
  "required": [
    "user_id",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}