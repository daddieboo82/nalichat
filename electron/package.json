{
  "name": "nalichat",
  "version": "1.0.0",
  "description": "NaliChat — collaborative workspace for music production",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.nalichat",
    "productName": "NaliChat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "error.html"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.music"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "publisherName": "Nalibase"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "differentialPackage": true,
      "artifactName": "NaliChat-Setup.${ext}"
    },
    "dmg": {
      "artifactName": "NaliChat.dmg"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}