{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "artist",
        "producer",
        "engineer",
        "ar"
      ],
      "default": "artist"
    },
    "display_name": {
      "type": "string"
    },
    "birthdate": {
      "type": "string",
      "format": "date",
      "description": "User's date of birth"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "phone": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "welcome_tour_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed or dismissed the guided welcome tour"
    },
    "reengagement_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last onboarding re-engagement email sent to this user (null = never sent)"
    },
    "violation_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of content policy violations recorded for this user"
    },
    "timeout_until": {
      "type": "string",
      "format": "date-time",
      "description": "If set and in the future, the user is timed out and cannot send messages until this time"
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "Permanently banned for repeated severe violations"
    },
    "squad_credits": {
      "type": "number",
      "default": 0,
      "description": "Squad & Scale co-op credits earned from hitting weekly squad goals"
    },
    "xp": {
      "type": "number",
      "default": 0,
      "description": "Experience points earned through platform activity"
    },
    "viral_concepts_generated": {
      "type": "number",
      "default": 0,
      "description": "Number of viral content concepts generated via ViralSeed AI"
    },
    "nali_presence_level": {
      "type": "string",
      "enum": [
        "proactive",
        "minimal",
        "off"
      ],
      "default": "proactive",
      "description": "How omnipresent Nali is across the app: proactive (auto hints), minimal (on-demand), or off (hidden)"
    }
  }
}